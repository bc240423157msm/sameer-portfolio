# Auth secret used to sign session JWTs — generate a long random string
# e.g. `openssl rand -base64 32`
AUTH_SECRET=replace-with-a-long-random-secret

# Built-in admin account (change these before deploying)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=replace-with-a-strong-password

# Built-in SEO/editor account
SEO_USERNAME=your-seo-username
SEO_PASSWORD=replace-with-a-strong-password

# Contact form email
CONTACT_EMAIL=you@example.com
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Your Name <you@example.com>

# Groq API for Sam AI chatbot — https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# ---- Persistent data storage (REQUIRED on Vercel) ----
# Without this, changes made from the admin dashboard (blog posts, site
# content, users) will reset every time you redeploy. Get these by going to
# your Vercel project -> Storage tab -> Create Database -> Upstash -> Redis.
# Vercel fills these in automatically once connected; you normally don't
# type them by hand.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Image uploads (REQUIRED on Vercel) ----
# Vercel project -> Storage tab -> Create Database -> Blob.
# Also auto-filled once connected.
BLOB_READ_WRITE_TOKEN=

# Resend audience for newsletter (optional — subscribers also stored in KV)
RESEND_AUDIENCE_ID=

# Sentry error monitoring (optional)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
