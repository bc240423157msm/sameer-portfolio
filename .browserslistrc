# Modern, evergreen browsers only — avoids Next.js/SWC shipping polyfills
# (Array.prototype.at/flat/flatMap, Object.fromEntries/hasOwn,
# String.prototype.trimStart/trimEnd, etc.) that these browsers already
# support natively. See: https://web.dev/articles/baseline-and-polyfills
production:
  chrome >= 91
  edge >= 91
  firefox >= 90
  safari >= 15
  ios_saf >= 15

development:
  last 1 chrome version
  last 1 firefox version
  last 1 safari version
